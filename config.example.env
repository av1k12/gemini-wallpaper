# Rectangle in points: x,y,width,height
# Shift-Command-4 shows the pointer coordinates and the selection size.
# Press Escape (do not release the drag), then fill this in.
REGION=0,0,800,600

# Point clicked between screenshots, in the same coordinates as REGION.
# Required when the repeat count is greater than 1.
CLICK=0,0

# Folder is created on the first successful run.
OUTPUT_DIR=~/Pictures/wallpapers

# Sent with each screenshot to Gemini in Safari.
GEMINI_PROMPT="extend and upscale this picture so that it is good for the background of a laptop screen."
